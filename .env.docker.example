# Шаблон для .env.docker — скопируй в .env.docker и заполни значения.
# cp .env.docker.example .env.docker

# Database
DB_USER=app
DB_PASSWORD=changeme
DB_NAME=interface_generator

# LLM — оставь mock для тестирования без API-ключа
LLM_MODE=mock
LLM_PROVIDER=gigachat
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
